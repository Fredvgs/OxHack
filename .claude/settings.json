{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "permissions": {
    "allow": [
      "Bash(uv run *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git blame *)",
      "Bash(git ls-files *)",
      "Bash(git add *)",
      "PowerShell(uv run *)",
      "PowerShell(git status *)",
      "PowerShell(git diff *)",
      "PowerShell(git log *)",
      "PowerShell(git show *)",
      "PowerShell(git blame *)",
      "PowerShell(git ls-files *)",
      "PowerShell(git add *)"
    ],
    "ask": [
      "Bash(git commit *)",
      "PowerShell(git commit *)"
    ],
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(rm -rf*)",
      "PowerShell(git push --force*)",
      "PowerShell(git push -f*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "uv",
            "args": ["run", "--quiet", "python", "${CLAUDE_PROJECT_DIR}/.claude/hooks/ruff_format.py"],
            "timeout": 30
          }
        ]
      }
    ]
  }
}
